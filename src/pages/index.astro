---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const variants = ['dom', 'siec', 'dane'] as const;
---

<BaseLayout title="Strona główna" hideHeader={true}>
	<div class="home-hero">
		<img src="/hero/home-rodzina-16x9.jpg" alt="Domowe AI" />
		<div class="home-hero-overlay">
			<h1>Domowe AI</h1>
		</div>
		<img src="/hero/home-rodzina-16x9.jpg" alt="" class="home-hero-foreground" />
		<img src="/hero/home-rodzina-16x9.jpg" alt="" class="home-hero-house-mask" />
	</div>
	<ul class="post-list">
		{
			posts.map((post, i) => (
				<li>
					<a href={`/${post.id}/`} class="post-card">
						<div class="post-thumb">
							{
								post.data.heroImage ? (
									<img src={post.data.heroImage} alt={post.data.title} />
								) : (
									<HeroArt variant={variants[i % variants.length]} />
								)
							}
						</div>
						<div class="post-info">
							<p class="post-meta">
								{post.data.pubDate.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
							</p>
							<h2>{post.data.title}</h2>
							<p class="post-description">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
	{posts.length === 0 && <p>Pierwszy post w przygotowaniu.</p>}
</BaseLayout>

<style>
	.home-hero {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		margin-bottom: 3rem;
		aspect-ratio: 1584 / 672;
		max-height: 60vh;
		overflow: hidden;
		border-bottom: 2px solid var(--accent);
	}

	.home-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home-hero > img:first-child {
		position: absolute;
		inset: 0;
	}

	.home-hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.home-hero-overlay h1 {
		position: absolute;
		top: 38%;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		font-size: clamp(4rem, 13vw, 9.5rem);
		line-height: 1;
		white-space: nowrap;
		letter-spacing: 0.01em;
		text-align: center;
		background: linear-gradient(
			90deg,
			transparent 0%,
			#e8836a 18%,
			#be0101 45%,
			#3acf45 72%,
			transparent 100%
		);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}

	.home-hero-foreground {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		clip-path: polygon(0.00% 53.57%, 1.26% 53.57%, 2.53% 51.19%, 3.79% 48.96%, 5.05% 46.88%, 6.31% 45.24%, 7.58% 43.60%, 8.84% 42.11%, 10.10% 41.07%, 11.36% 40.03%, 12.63% 39.29%, 13.89% 38.84%, 15.15% 38.69%, 16.41% 38.69%, 17.68% 38.99%, 18.94% 39.58%, 20.20% 40.33%, 21.46% 41.22%, 22.73% 42.26%, 23.99% 43.60%, 25.25% 44.94%, 26.52% 46.28%, 27.78% 47.77%, 29.04% 49.26%, 30.30% 50.74%, 31.57% 52.08%, 32.83% 53.42%, 34.09% 54.76%, 35.35% 55.95%, 36.62% 56.99%, 37.88% 57.89%, 39.14% 58.78%, 40.40% 59.52%, 41.67% 59.97%, 42.93% 60.42%, 44.19% 60.71%, 45.45% 61.01%, 46.72% 61.01%, 47.98% 61.01%, 49.24% 60.86%, 50.51% 60.71%, 51.77% 60.42%, 53.03% 59.97%, 54.29% 59.67%, 55.56% 59.23%, 56.82% 58.78%, 58.08% 58.33%, 59.34% 58.04%, 60.61% 57.89%, 61.87% 57.74%, 63.13% 57.74%, 64.39% 58.04%, 65.66% 58.48%, 66.92% 59.08%, 68.18% 60.12%, 69.44% 61.01%, 70.71% 60.12%, 71.97% 58.93%, 73.23% 58.04%, 74.49% 57.14%, 75.76% 56.10%, 77.02% 55.21%, 78.28% 54.46%, 79.55% 53.57%, 80.81% 52.98%, 82.07% 52.23%, 83.33% 51.64%, 84.60% 51.19%, 85.86% 50.89%, 87.12% 50.74%, 88.38% 50.60%, 89.65% 50.60%, 90.91% 50.60%, 92.17% 50.89%, 93.43% 51.19%, 94.70% 51.93%, 95.96% 52.53%, 97.22% 53.27%, 98.48% 54.17%, 100.00% 54.17%, 100% 100%, 0% 100%);
	}

	.home-hero-house-mask {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		clip-path: polygon(44.19% 49.85%, 44.19% 35.71%, 47.98% 34.97%, 50.51% 34.23%, 53.66% 34.97%, 56.82% 36.46%, 57.45% 44.64%, 57.45% 49.85%);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list li {
		margin-bottom: 2.5rem;
	}

	.post-card {
		display: block;
		text-decoration: none;
		color: var(--fg);
		border: 1px solid var(--border);
	}

	.post-card:hover {
		border-color: var(--accent);
	}

	.post-thumb {
		border-bottom: 2px solid var(--accent);
		line-height: 0;
	}

	.post-thumb img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.post-info {
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.post-meta {
		color: var(--muted);
		font-size: 0.75rem;
		font-family: 'SF Mono', Consolas, monospace;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0 0 0.6rem;
	}

	.post-card h2 {
		font-size: 1.3rem;
		margin: 0 0 0.6rem;
	}

	.post-description {
		margin: 0;
		color: var(--muted);
	}
</style>
