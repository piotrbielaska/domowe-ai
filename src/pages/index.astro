---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const variants = ['dom', 'siec', 'dane'] as const;
---

<BaseLayout title="Strona główna" hideHeader={true} flushTop={true}>
	<div class="home-hero">
		<img src="/hero/home-rodzina-16x9.jpg" alt="Domowe AI" />
		<div class="home-hero-overlay">
			<h1>Domowe <span class="hero-title-accent">AI</span></h1>
		</div>
	</div>
	<ul class="post-list">
		{
			posts.map((post, i) => (
				<li>
					<a href={`/${post.id}/`} class="post-card">
						<div class="post-thumb">
							{
								post.data.heroImage ? (
									<img src={post.data.heroImage} alt={post.data.title} />
								) : (
									<HeroArt variant={variants[i % variants.length]} />
								)
							}
						</div>
						<div class="post-info">
							<p class="post-meta">
								{post.data.pubDate.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
							</p>
							<h2>{post.data.title}</h2>
							<p class="post-description">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
	{posts.length === 0 && <p>Pierwszy post w przygotowaniu.</p>}
</BaseLayout>

<style>
	.home-hero {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		margin-bottom: 3rem;
		aspect-ratio: 1584 / 672;
		max-height: 60vh;
		overflow: hidden;
		border-bottom: 2px solid var(--accent);
	}

	.home-hero img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.home-hero > img:first-child {
		position: absolute;
		inset: 0;
	}

	.home-hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.home-hero-overlay h1 {
		position: absolute;
		top: 62%;
		left: 50%;
		transform: translateX(-50%);
		margin: 0;
		font-size: clamp(4rem, 13vw, 9.5rem);
		line-height: 1;
		white-space: nowrap;
		letter-spacing: 0.01em;
		text-align: center;
		color: var(--fg);
	}

	.hero-title-accent {
		background: var(--brand-gradient);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list li {
		margin-bottom: 2.5rem;
	}

	.post-card {
		display: block;
		text-decoration: none;
		color: var(--fg);
		border: 1px solid var(--border);
	}

	.post-card:hover {
		border-color: var(--accent);
	}

	.post-thumb {
		border-bottom: 2px solid var(--accent);
		line-height: 0;
	}

	.post-thumb img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.post-info {
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.post-meta {
		color: var(--muted);
		font-size: 0.75rem;
		font-family: 'SF Mono', Consolas, monospace;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0 0 0.6rem;
	}

	.post-card h2 {
		font-size: 1.3rem;
		margin: 0 0 0.6rem;
	}

	.post-description {
		margin: 0;
		color: var(--muted);
	}
</style>
