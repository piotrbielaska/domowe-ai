---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Domowe AI — buduję narzędzia dla rodziny z pomocą AI i pokazuję jak to zrobić samemu.' } = Astro.props;
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Domowe AI</title>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand">Domowe AI</a>
			<p class="tagline">Buduję narzędzia dla rodziny z pomocą AI — i pokazuję jak to zrobić samemu.</p>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>Domowe AI &middot; {new Date().getFullYear()}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--fg: #1a1a1a;
		--bg: #ffffff;
		--muted: #6b6b6b;
		--accent: #2f6f4f;
		--border: #e5e5e5;
		--max-width: 680px;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--fg: #e8e8e8;
			--bg: #14161a;
			--muted: #9a9a9a;
			--accent: #6fce9f;
			--border: #2a2d33;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: var(--fg);
		background: var(--bg);
		line-height: 1.6;
	}

	.site-header {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.brand {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--fg);
		text-decoration: none;
	}

	.tagline {
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	a {
		color: var(--accent);
	}

	h1,
	h2,
	h3 {
		line-height: 1.25;
	}

	.site-footer {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem 1.25rem 3rem;
		color: var(--muted);
		font-size: 0.85rem;
		border-top: 1px solid var(--border);
	}
</style>
