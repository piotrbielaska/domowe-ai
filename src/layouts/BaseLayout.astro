---
import '@fontsource/josefin-sans/400.css';
import '@fontsource/josefin-sans/500.css';
import '@fontsource/josefin-sans/700.css';

interface Props {
	title: string;
	description?: string;
	hideHeader?: boolean;
	flushTop?: boolean;
}

const { title, description = 'Domowe AI — buduję narzędzia dla rodziny z pomocą AI i pokazuję jak to zrobić samemu.', hideHeader = false, flushTop = false } = Astro.props;
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Domowe AI</title>
	</head>
	<body>
		<header class="site-header" class:list={[{ 'is-hidden': hideHeader }]}>
			<div class="header-inner">
				<a href="/" class="brand">DOMOWE <span class="brand-accent">AI</span></a>
				<nav class="site-nav">
					<a href="/">Wpisy</a>
				</nav>
			</div>
		</header>
		<main class:list={[{ 'flush-top': flushTop }]}>
			<slot />
		</main>
		<footer class="site-footer">
			<p>Domowe AI &middot; {new Date().getFullYear()}</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--fg: #e0e8f0;
		--bg: #000000;
		--bg-surface: #101010;
		--muted: #7c8794;
		--accent: #54cec8;
		--accent-warm: #ea8f21;
		--border: rgba(84, 206, 200, 0.16);
		--max-width: 700px;
		--font-display: 'Josefin Sans', -apple-system, sans-serif;
		--font-mono: 'SF Mono', Consolas, monospace;
		--brand-gradient: linear-gradient(180deg, #54cec8 0%, #e8d24a 45%, #ea8f21 75%, transparent 100%);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: var(--fg);
		background: var(--bg);
		line-height: 1.65;
	}

	.site-header {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 1.5rem;
		border-bottom: 1px solid var(--border);
	}

	.site-header.is-hidden {
		display: none;
	}

	.header-inner {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--fg);
		text-decoration: none;
	}

	.brand-accent {
		background: var(--brand-gradient);
		background-clip: text;
		-webkit-background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
	}

	.site-nav a {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
	}

	.site-nav a:hover {
		color: var(--accent);
	}

	.tagline {
		margin: 0.6rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	main.flush-top {
		padding-top: 0;
	}

	a {
		color: var(--accent);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	h1 {
		font-size: 2.2rem;
	}

	.site-footer {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 1.5rem 1.25rem 3rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-family: var(--font-mono);
		border-top: 1px solid var(--border);
	}
</style>
